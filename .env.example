# Copiar para .env — nunca commitar o .env
# Mesmo projeto Supabase no local e no Railway.

# URI Postgres do projeto (Settings > Database). Preferir pooler :6543.
SUPABASE_STRING=
# Chave da API da Anthropic (Claude).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Opcional: modelo dedicado à escolha da empresa entre candidatos fechados.
CLAUDE_DECISION_MODEL=claude-haiku-5-5
# Agente de triagem automática (usa CLAUDE_DECISION_MODEL): 0 desliga a
# rodada depois da coleta semanal.
CAPEX_AGENTE_AUTO=1
# Funil de notícias (src/capex-fases.js): captação, Filtro 1 (CLAUDE_MODEL),
# Filtro 2, Enriquecimento, Filtro 3 e aprovação humana. Cada fase de IA
# depois da triagem tem um modelo e um interruptor (0 desliga).
# Filtro 2 (Filtro CapEx): definição rígida de CapEx sobre a manchete.
CLAUDE_FILTER_MODEL=claude-sonnet-5-5
CAPEX_FILTRO=1
# Enriquecimento: acha a matéria original na web e monta o perfil do projeto.
# Usa as ferramentas de busca e leitura da API (cobradas por busca).
CLAUDE_ENRICH_MODEL=claude-sonnet-5-5
CAPEX_ENRIQUECIMENTO=1
# Filtro 3: relê o perfil enriquecido antes da aprovação humana.
CLAUDE_FILTER3_MODEL=claude-sonnet-5-5
CAPEX_FILTRO_FINAL=1

# Catálogo dados.gov.br. Header chave-api-dados-abertos. Não commitar o valor.
TOKEN_DADOS_GOV=

# Só em desenvolvimento. No Railway a plataforma injeta PORT — não definir lá.
PORT=3000

# Produção (Railway): NODE_ENV=production
NODE_ENV=development

# Opcional: desliga varredura automática semanal (scanner/descoberta).
# DISABLE_SCHEDULER=1
